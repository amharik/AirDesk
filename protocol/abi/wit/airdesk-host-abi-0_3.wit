package airdesk:host-abi@0.3.0;

// AirDesk capability host ABI, WASI 0.3 / component-model async baseline.
//
// This is a separate package and world from the 0.2 ABI. It uses async
// functions, stream<T> and future<T> directly and has no wasi:io import.
// Host implementations still revalidate the capability token and lease on
// every call, including every stream operation. Frames are never submitted
// through this ABI.

interface types {
  type capability-token = list<u8>;

  enum abi-error-code {
    invalid-argument,
    unsupported,
    lease-invalid,
    lease-expired,
    lease-revoked,
    permission-denied,
    not-found,
    path-escape,
    busy,
    unavailable,
    flow-control,
    conflict,
    internal,
  }

  /// Safe, typed host-call failure. Messages must not contain host paths,
  /// capability tokens, credentials or other secrets.
  record abi-error {
    code: abi-error-code,
    message: string,
    retryable: bool,
    lease-id: option<string>,
    audit-id: option<string>,
  }

  enum file-kind {
    unknown,
    file,
    directory,
    symlink,
    other,
  }

  flags open-flags {
    read,
    write,
    create,
    truncate,
    directory,
    no-follow,
  }

  record file-stat {
    kind: file-kind,
    size: u64,
    mode: u32,
    modified-at-epoch-ms: option<u64>,
    read-only: bool,
  }

  record directory-entry {
    name: string,
    kind: file-kind,
  }

  record lease-context {
    lease-id: string,
    capability-uri: string,
    workspace-id: string,
    application-id: string,
    requester-id: string,
    granted-operations: list<string>,
    issued-at-epoch-ms: u64,
    expires-at-epoch-ms: u64,
    lease-epoch: u64,
  }

  record capability-grant {
    token: capability-token,
    context: lease-context,
  }

  record pty-credit-window {
    max-in-flight-bytes: u64,
    resume-threshold-bytes: u64,
    max-chunk-bytes: u64,
  }

  record exit-status {
    code: s32,
    signal: option<u32>,
  }

  enum display-role {
    view-only,
    controller,
  }

  record viewport {
    width: u32,
    height: u32,
  }

  record origin-policy {
    allowed-origins: list<string>,
    loopback-only: bool,
    require-secure-context: bool,
  }

  record display-registration {
    origin: string,
    workspace-id: string,
    display-session-id: string,
    generation: u64,
    viewport: viewport,
    focus-target: option<string>,
    role: display-role,
  }

  record presentation-state {
    workspace-id: string,
    display-session-id: string,
    generation: u64,
    lease-epoch: u64,
    viewport: viewport,
    focus-target: option<string>,
    active-controller-id: option<string>,
    role: display-role,
    can-write-workspace: bool,
  }
}

interface vfs-service {
  use types.{
    abi-error,
    capability-grant,
    directory-entry,
    file-stat,
    open-flags,
  };

  /// A confined AD-RESOURCE subtree. Path arguments are relative to this node
  /// and must reject `..` escapes and unleased symlink follows.
  resource node {
    stat: async func(grant: capability-grant) -> result<file-stat, abi-error>;
    open-at: async func(path: string, mode: open-flags, grant: capability-grant) -> result<node, abi-error>;
    read-via-stream: func(offset: u64, length: u64, grant: capability-grant) -> tuple<stream<u8>, future<result<_, abi-error>>>;
    write-via-stream: func(data: stream<u8>, offset: u64, grant: capability-grant) -> future<result<_, abi-error>>;
    readdir: func(grant: capability-grant) -> result<tuple<stream<directory-entry>, future<result<_, abi-error>>>, abi-error>;
    close: async func(grant: capability-grant) -> result<_, abi-error>;
  }

  mount-capability: async func(grant: capability-grant) -> result<node, abi-error>;
}

interface pty-service {
  use types.{
    abi-error,
    capability-grant,
    exit-status,
    pty-credit-window,
  };

  /// A lease-bound PTY session. The 0.3 direction flip applies: the guest
  /// supplies stdin data as a stream and receives a completion future; stdout
  /// returns the stream-plus-terminal-future tuple.
  resource pty-session {
    write-stdin: func(data: stream<u8>, grant: capability-grant) -> future<result<_, abi-error>>;
    read-stdout: func(grant: capability-grant) -> tuple<stream<u8>, future<result<_, abi-error>>>;
    resize: async func(columns: u32, rows: u32, grant: capability-grant) -> result<_, abi-error>;
    terminate: async func(grant: capability-grant) -> result<_, abi-error>;
    wait: func(grant: capability-grant) -> future<result<exit-status, abi-error>>;
    credits: func() -> pty-credit-window;
  }

  spawn: async func(
    command: string,
    arguments: list<string>,
    columns: u32,
    rows: u32,
    grant: capability-grant,
  ) -> result<pty-session, abi-error>;
}

interface display-sink {
  use types.{
    abi-error,
    capability-grant,
    display-registration,
    origin-policy,
    presentation-state,
  };

  /// Presentation-state handle for one display session. There is no frame,
  /// surface, pixel or submit operation in this interface.
  resource display-session {
    state: func(grant: capability-grant) -> result<presentation-state, abi-error>;
    update-presentation: func(state: presentation-state, grant: capability-grant) -> result<presentation-state, abi-error>;
    close: func(grant: capability-grant) -> result<_, abi-error>;
  }

  register-sink: func(
    registration: display-registration,
    policy: origin-policy,
    grant: capability-grant,
  ) -> result<display-session, abi-error>;
}

world capability-host-0-3 {
  import types;
  import vfs-service;
  import pty-service;
  import display-sink;
}
