namespace AirDesk.Protocol;

enum EventType : ubyte {
  pointer_move = 0,
  pointer_down = 1,
  pointer_up = 2,
  pointer_click = 3,
  pointer_cancel = 4,
  scroll = 5,
  key_down = 6,
  key_up = 7,
  text_input = 8,
  focus_changed = 9,
  viewport_changed = 10
}

enum ControlType : ubyte {
  ready = 0,
  ack = 1,
  viewport = 2,
  notice = 3,
  state = 4,
  error = 5,
  appearance = 6,
  action = 7,
  session_start = 8,
  session_end = 9,
  ping = 10,
  pong = 11,
  log = 12
}

enum SenderRole : ubyte {
  unspecified = 0,
  controller = 1,
  host = 2,
  observer = 3,
  agent = 4,
  system = 5
}

enum Availability : ubyte {
  unknown = 0,
  available = 1,
  busy = 2,
  restricted = 3,
  unavailable = 4
}

enum Authorization : ubyte {
  unknown = 0,
  ungranted = 1,
  granted = 2,
  denied = 3,
  revoked = 4
}

enum MergeClass : ubyte {
  unknown = 0,
  lww = 1,
  append_log = 2,
  manual = 3
}

enum ChannelBindingKind : ubyte {
  none = 0,
  tls_exporter = 1,
  certificate_hash = 2
}

enum DeviceKind : ubyte {
  unknown = 0,
  phone = 1,
  tablet = 2,
  desktop = 3,
  browser = 4,
  display = 5,
  server = 6,
  agent = 7
}

table InputEvent {
  version:uint = 1 (id: 0);
  type:EventType (id: 1);
  session_id:string (required, id: 2);
  generation:uint = 0 (id: 3);
  seq:uint (id: 4);
  timestamp:ulong (id: 5);
  x:float (id: 6);
  y:float (id: 7);
  dx:float (id: 8);
  dy:float (id: 9);
  button:ubyte (id: 10);
  click_count:ubyte = 1 (id: 11);
  key:string (id: 12);
  code:string (id: 13);
  modifiers:[string] (id: 14);
  text:string (id: 15);
  width:float (id: 16);
  height:float (id: 17);
  target:string (id: 18);
}

table ControlMessage {
  version:uint = 1 (id: 0);
  type:ControlType (id: 1);
  session_id:string (required, id: 2);
  generation:uint = 0 (id: 3);
  seq:uint (id: 4);
  timestamp:ulong (id: 5);
  appearance:string (id: 6);
  message:string (id: 7);
  action:string (id: 8);
  width:float (id: 9);
  height:float (id: 10);
  code:string (id: 11);
}

// Optional control-plane metadata carried alongside any Envelope payload.
// All fields are optional so existing v1 envelopes remain valid.
table ControlHeader {
  message_id:string (id: 0); // opaque UTF-8 id; applications should cap at 128 bytes
  sender_device_id:string (id: 1); // stable opaque device id; cap at 128 bytes
  sender_role:SenderRole = unspecified (id: 2);
  correlation_id:string (id: 3); // request/response correlation; cap at 128 bytes
  idempotency_key:string (id: 4); // retry key; cap at 128 bytes
  expires_at:ulong (id: 5); // Unix epoch milliseconds; 0 means unset
  cancellation_id:string (id: 6); // id of the operation being cancelled; cap at 128 bytes
}

// Identity fields only. public_key is an opaque encoding carried for future
// use; this schema does not implement, verify or assert any crypto.
table DeviceIdentity {
  version:uint = 1 (id: 0);
  kind:DeviceKind = unknown (id: 1);
  device_id:string (id: 2); // stable opaque id; cap at 128 bytes
  public_key:string (id: 3); // encoded public key; no crypto implemented here
  nonce:[ubyte] (id: 4); // opaque challenge/response bytes
  expires_at:ulong (id: 5); // Unix epoch milliseconds; 0 means unset
  channel_binding_kind:ChannelBindingKind = none (id: 6);
  channel_binding_value:string (id: 7); // opaque binding value; cap at 512 bytes
  capabilities:[string] (id: 8); // capability URI hints only, not a lease
}

table PairingOffer {
  identity:DeviceIdentity (id: 0);
  offer_nonce:[ubyte] (id: 1);
  expires_at:ulong (id: 2); // Unix epoch milliseconds; 0 means unset
  channel_binding_kind:ChannelBindingKind = none (id: 3);
  channel_binding_value:string (id: 4); // opaque binding value; cap at 512 bytes
  capabilities:[string] (id: 5);
}

table PairingResponse {
  identity:DeviceIdentity (id: 0);
  offer_nonce:[ubyte] (id: 1);
  response_nonce:[ubyte] (id: 2);
  accepted:bool = false (id: 3);
  expires_at:ulong (id: 4); // Unix epoch milliseconds; 0 means unset
  channel_binding_kind:ChannelBindingKind = none (id: 5);
  channel_binding_value:string (id: 6); // opaque binding value; cap at 512 bytes
  capabilities:[string] (id: 7);
}

table CapabilityDescriptor {
  cap_uri:string (id: 0); // e.g. airdesk://capability/display; cap at 256 bytes
  version:uint = 1 (id: 1);
  provider_device_id:string (id: 2);
  availability:Availability = unknown (id: 3);
  authorization:Authorization = unknown (id: 4);
  permissions:[string] (id: 5);
  execution:string (id: 6); // descriptive execution mode, cap at 128 bytes
  transport:string (id: 7); // descriptive transport hint, cap at 128 bytes
  constraints:string (id: 8); // opaque JSON/description, cap at 4096 bytes
}

table CapabilityLease {
  lease_id:string (id: 0); // cap at 128 bytes
  cap_uri:string (id: 1); // cap at 256 bytes
  workspace_id:string (id: 2); // cap at 128 bytes
  application_id:string (id: 3); // cap at 128 bytes
  requester_device_id:string (id: 4); // cap at 128 bytes
  session_id:string (id: 5); // cap at 128 bytes
  issued_at:ulong (id: 6); // Unix epoch milliseconds
  expires_at:ulong (id: 7); // Unix epoch milliseconds; 0 means unset
  revoked:bool = false (id: 8);
  revocation_reason:string (id: 9); // cap at 256 bytes
  operations:[string] (id: 10); // allowed operation names
  audit_id:string (id: 11); // cap at 128 bytes
}

table Viewport {
  width:uint (id: 0);
  height:uint (id: 1);
  scale:float = 1.0 (id: 2);
  orientation:string (id: 3); // e.g. landscape/portrait; cap at 32 bytes
}

table DisplaySession {
  workspace_id:string (id: 0); // cap at 128 bytes
  display_id:string (id: 1); // cap at 128 bytes
  viewport:Viewport (id: 2);
  profile:string (id: 3); // display profile name; cap at 128 bytes
  generation:uint = 0 (id: 4);
}

// Schema primitives only. Payload hashes are opaque digests; no sync is implied.
table SyncRecord {
  workspace_id:string (id: 0);
  record_id:string (id: 1);
  device_id:string (id: 2);
  user_id:string (id: 3);
  seq:ulong (id: 4);
  merge_class:MergeClass = unknown (id: 5);
  payload_hash:[ubyte] (id: 6);
}

table GroupMember {
  workspace_id:string (id: 0);
  device_id:string (id: 1);
  user_id:string (id: 2);
  role:string (id: 3); // collaboration role name; cap at 64 bytes
  seq:ulong (id: 4);
}

// ADFP-local resource RPC op codes. These are not 9P2000 message types and
// this path does not tunnel 9P2000 frames.
enum ResourceOpCode : uint {
  attach = 100,
  attach_result = 101,
  walk = 102,
  walk_result = 103,
  open = 104,
  open_result = 105,
  read = 106,
  read_result = 107,
  write = 108,
  write_result = 109,
  clunk = 110,
  clunk_result = 111,
  stat = 112,
  stat_result = 113,
  wstat = 114,
  wstat_result = 115,
  compound = 116,
  compound_result = 117
}

enum BlobAlgorithm : ubyte {
  blake3 = 1
}

enum BindMode : ubyte {
  read_only = 0,
  read_write = 1,
  exec = 2,
  append = 3
}

enum ResourceStatus : ubyte {
  ok = 0,
  not_found = 1,
  unauthorized = 2,
  revoked = 3,
  unavailable = 4,
  conflict = 5,
  invalid = 6
}

// Field order matches the 9P Qid tuple. FlatBuffers struct alignment is not a
// 9P2000 wire frame; interoperability requires a separate 9P adapter.
struct Qid {
  type:ubyte;
  version:uint;
  path:ulong;
}

table ResourceStat {
  qid:Qid (id: 0);
  mode:uint (id: 1);
  length:ulong (id: 2);
  name:string (id: 3); // cap at 256 bytes
  modified_at:ulong (id: 4); // Unix epoch milliseconds
}

table ResourceAttach {
  fid:uint (id: 0);
  afid:uint (id: 1);
  uname:string (id: 2); // cap at 128 bytes
  aname:string (id: 3); // opfs, tarfs, tmpfs or hostfs
  cose_token:[ubyte] (id: 4); // ADR-012 COSE_Sign1 token
}

table ResourceAttachResult {
  fid:uint (id: 0);
  qid:Qid (id: 1);
}

table ResourceWalk {
  fid:uint (id: 0);
  new_fid:uint (id: 1);
  wnames:[string] (id: 2); // capability-relative path segments
}

table ResourceWalkResult {
  wqids:[Qid] (id: 0);
}

table ResourceOpen {
  fid:uint (id: 0);
  mode:BindMode = read_only (id: 1);
}

table ResourceOpenResult {
  qid:Qid (id: 0);
  iounit:uint = 65536 (id: 1);
}

table ResourceRead {
  fid:uint (id: 0);
  offset:ulong (id: 1);
  count:uint (id: 2);
}

table BlobHandle {
  version:uint = 1 (id: 0);
  algorithm:BlobAlgorithm = blake3 (id: 1);
  digest:[ubyte] (id: 2); // 32-byte BLAKE3 digest
  length:ulong (id: 3);
  expires_at:ulong (id: 4); // Unix epoch milliseconds; 0 means no expiry
}

table ResourceReadResult {
  data:[ubyte] (id: 0);
  blob:BlobHandle (id: 1);
}

table ResourceWrite {
  fid:uint (id: 0);
  offset:ulong (id: 1);
  data:[ubyte] (id: 2);
}

table ResourceWriteResult {
  count:uint (id: 0);
}

table ResourceClunk {
  fid:uint (id: 0);
}

table ResourceClunkResult {
  status:ResourceStatus = ok (id: 0);
}

table ResourceStatRequest {
  fid:uint (id: 0);
}

table ResourceStatResult {
  stat:ResourceStat (id: 0);
}

table ResourceWstat {
  fid:uint (id: 0);
  stat:ResourceStat (id: 1);
}

table ResourceWstatResult {
  status:ResourceStatus = ok (id: 0);
}

table ResourceCompoundRequest {
  request_id:ulong (id: 0);
  fid:uint (id: 1);
  new_fid:uint (id: 2);
  wnames:[string] (id: 3);
  open_mode:BindMode = read_only (id: 4);
  read_offset:ulong (id: 5);
  read_count:uint (id: 6);
  clunk:bool = true (id: 7);
}

table ResourceCompoundResult {
  request_id:ulong (id: 0);
  status:ResourceStatus = ok (id: 1);
  qid:Qid (id: 2);
  iounit:uint = 65536 (id: 3);
  data:[ubyte] (id: 4);
  blob:BlobHandle (id: 5);
  stat:ResourceStat (id: 6);
  clunk_status:ResourceStatus = ok (id: 7);
}

union ResourceRpcPayload {
  ResourceAttach,
  ResourceAttachResult,
  ResourceWalk,
  ResourceWalkResult,
  ResourceOpen,
  ResourceOpenResult,
  ResourceRead,
  ResourceReadResult,
  ResourceWrite,
  ResourceWriteResult,
  ResourceClunk,
  ResourceClunkResult,
  ResourceStatRequest,
  ResourceStatResult,
  ResourceWstat,
  ResourceWstatResult,
  ResourceCompoundRequest,
  ResourceCompoundResult
}

table ResourceRpc {
  payload:ResourceRpcPayload (id: 1);
  op_code:ResourceOpCode = attach (id: 2);
}

union MessagePayload {
  InputEvent,
  ControlMessage
}

enum TerminalMessageType : uint {
  attach = 0,
  attached = 1,
  data = 2,
  resize = 3,
  detach = 4,
  exit = 5,
  error = 6
}

// Persistent PTY attachment. Requests carry only a lease id; the daemon
// authorizes it against locally provisioned leases. Data is raw PTY bytes.
table TerminalMessage {
  version:uint = 1 (id: 0);
  type:TerminalMessageType (id: 1);
  session_id:string (required, id: 2);
  client_id:string (id: 3);
  lease:CapabilityLease (id: 4);
  sequence:ulong (id: 5);
  replay_from_sequence:ulong (id: 6);
  oldest_sequence:ulong (id: 7);
  data:[ubyte] (id: 8);
  columns:uint = 80 (id: 9);
  rows:uint = 24 (id: 10);
  exit_code:int = 0 (id: 11);
  message:string (id: 12);
  truncated:bool = false (id: 13);
}

// Additive fabric union. Existing MessagePayload members are untouched so v1
// baseline conformance is preserved.
union FabricPayload {
  DeviceIdentity,
  PairingOffer,
  PairingResponse,
  CapabilityDescriptor,
  CapabilityLease,
  DisplaySession,
  SyncRecord,
  GroupMember,
  ResourceRpc,
  TerminalMessage
}

table Envelope {
  version:uint = 1 (id: 0);
  payload:MessagePayload (id: 2);
  header:ControlHeader (id: 3);
  fabric_payload:FabricPayload (id: 5);
}

root_type Envelope;
file_identifier "ADEN";
