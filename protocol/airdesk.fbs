namespace AirDesk.Protocol;

enum EventType : ubyte {
  pointer_move = 0,
  pointer_down = 1,
  pointer_up = 2,
  pointer_click = 3,
  pointer_cancel = 4,
  scroll = 5,
  key_down = 6,
  key_up = 7,
  text_input = 8,
  focus_changed = 9,
  viewport_changed = 10
}

enum ControlType : ubyte {
  ready = 0,
  ack = 1,
  viewport = 2,
  notice = 3,
  state = 4,
  error = 5,
  appearance = 6,
  action = 7,
  session_start = 8,
  session_end = 9,
  ping = 10,
  pong = 11,
  log = 12
}

table InputEvent {
  version:uint = 1 (id: 0);
  type:EventType (id: 1);
  session_id:string (required, id: 2);
  generation:uint = 0 (id: 3);
  seq:uint (id: 4);
  timestamp:ulong (id: 5);
  x:float (id: 6);
  y:float (id: 7);
  dx:float (id: 8);
  dy:float (id: 9);
  button:ubyte (id: 10);
  click_count:ubyte = 1 (id: 11);
  key:string (id: 12);
  code:string (id: 13);
  modifiers:[string] (id: 14);
  text:string (id: 15);
  width:float (id: 16);
  height:float (id: 17);
  target:string (id: 18);
}

table ControlMessage {
  version:uint = 1 (id: 0);
  type:ControlType (id: 1);
  session_id:string (required, id: 2);
  generation:uint = 0 (id: 3);
  seq:uint (id: 4);
  timestamp:ulong (id: 5);
  appearance:string (id: 6);
  message:string (id: 7);
  action:string (id: 8);
  width:float (id: 9);
  height:float (id: 10);
  code:string (id: 11);
}

union MessagePayload {
  InputEvent,
  ControlMessage
}

table Envelope {
  version:uint = 1 (id: 0);
  payload:MessagePayload (id: 2);
}

root_type Envelope;
file_identifier "ADEN";
