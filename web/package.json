{
  "name": "airdesk-desktop-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:check && npm run licenses",
    "build:check": "node scripts/build.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "licenses": "node scripts/check-dependencies.mjs",
    "sbom": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "@wterm/core": "0.5.7",
    "@wterm/dom": "0.5.7",
    "flatbuffers": "25.9.23",
    "winbox": "0.2.82"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@wterm/just-bash": "0.5.7",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "just-bash": "3.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
