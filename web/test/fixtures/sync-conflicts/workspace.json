        "fields": {}
      },
      "remote": {
        "workspaceId": "ws-1",
        "hostEpoch": 3,
        "workspaceSeq": 10,
        "revision": 4,
        "metadata": [],
        "fields": {}
      }
    },
    "expected": {
      "status": "rejected",
      "reason": "future-epoch",
      "conflicts": [],
      "snapshot": { "workspaceSeq": 10, "revision": 3, "fields": {} }
    }
  }
