[
  {
    "id": "apply-stale-epoch",
    "description": "A patch from an older host epoch is rejected before any field is considered.",
    "operation": {
      "kind": "apply-patch",
      "snapshot": {
        "workspaceId": "ws-1",
        "hostEpoch": 2,
        "workspaceSeq": 10,
        "revision": 3,
        "metadata": [],
        "fields": {}
      },
      "patch": {
        "workspaceId": "ws-1",
        "senderDeviceId": "dev-a",
        "hostEpoch": 1,
        "baseWorkspaceSeq": 10,
        "revision": 4,
        "fields": []
      }
    },
    "expected": {
      "status": "rejected",
      "reason": "stale-epoch",
      "conflicts": [],
      "snapshot": { "workspaceSeq": 10, "revision": 3, "fields": {} }
    }
  },
